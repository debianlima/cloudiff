+    source_items={(str(x.get('service') or ''),str(x.get('name') or '')):x for x in (src_entries.get('entries') or [])}
+    target_items={(str(x.get('service') or ''),str(x.get('name') or '')):x for x in (tgt_entries.get('entries') or [])}
+    changes=[]
