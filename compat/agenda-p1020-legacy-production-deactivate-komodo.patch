+def cloudif_publication_deactivate_legacy(handler):
+    if not _cloudif_pub_auth(handler):return send(handler,403,{'ok':False,'error':'forbidden'})
+    payload=_cloudif_pub_json(handler);project=safe_slug(payload.get('project') or '')
+    try:num=int(payload.get('public_number'));publication=int(payload.get('publication_number'))
+    except Exception:return send(handler,400,{'ok':False,'error':'invalid_legacy_deactivation_request'})
+    if not project or num<1 or publication<1:return send(handler,400,{'ok':False,'error':'invalid_legacy_deactivation_request'})
+    container=f'cloudif-p{num}-p{publication}-publication-web'
+    inspect=subprocess.run(['docker','inspect',container],text=True,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
+    if inspect.returncode!=0:return send(handler,200,{'ok':True,'project':project,'public_number':num,'publication_number':publication,'container':container,'status':'absent','idempotent':True,'resourcesPreserved':True,'secretValuesIncluded':False})
+    try:row=json.loads(inspect.stdout or '[]')[0]
+    except Exception:return send(handler,409,{'ok':False,'error':'legacy_publication_inspect_invalid'})
+    labels=((row.get('Config') or {}).get('Labels') or {})
+    if labels.get('cloudif.project')!=project or labels.get('cloudif.stage')!='publication' or str(labels.get('cloudif.stage-number') or '')!=str(publication):
+        return send(handler,409,{'ok':False,'error':'legacy_publication_identity_mismatch','message':'O container legado não corresponde ao projeto/publicação esperados.'})
+    state=(row.get('State') or {}).get('Status') or ''
+    if state=='running':
+        stop=subprocess.run(['docker','stop','-t','20',container],text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=30)
+        if stop.returncode!=0:return send(handler,422,{'ok':False,'error':'legacy_publication_stop_failed','message':'Não foi possível desativar a Produção anterior.'})
+    return send(handler,200,{'ok':True,'project':project,'public_number':num,'publication_number':publication,'container':container,'status':'inactive','idempotent':state!='running','resourcesPreserved':True,'containerRemoved':False,'volumesRemoved':0,'secretValuesIncluded':False})
+
