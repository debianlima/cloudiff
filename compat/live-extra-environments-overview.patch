+def _sgrep_w1_live_http()->tuple[bool,str]:
+    # TLS-verifies the public W1 URL and obtains the *running* image commit,
+    # independently from Git checkout and the original adoption record.
+    import re
+    import urllib.error
+    import urllib.request
+    target='https://1026-w1-preview.cloudiff.duckdns.org/health'
+    try:
+        request=urllib.request.Request(target,headers={'Cache-Control':'no-cache'},method='GET')
+        with urllib.request.urlopen(request,timeout=6) as response:
+            if response.status!=200 or response.geturl()!=target:return False,''
+            body=json.loads(response.read(800).decode('utf-8','replace'))
+            if not isinstance(body,dict) or body.get('ok') is not True or body.get('service')!='sgrep-web':
+                return False,''
+            sha=str(response.headers.get('X-CloudIFF-Source-Commit') or '').strip()
+            if not re.fullmatch(r'[a-f0-9]{40}',sha):sha=''
+            return True,sha
+    except (urllib.error.URLError,ValueError,OSError,TimeoutError):
+        return False,''
+
+
+def _linked_sgrep_source_preview(slug:str)->dict[str,Any]:
+    # Read-only adopted Preview W1; no synthetic CloudIFF broker deployment.
+    if slug!='sgrep-v2' or not PORTAL_DB.exists():return {}
+    try:
+        with sqlite3.connect(f'file:{PORTAL_DB}?mode=ro',uri=True,timeout=10) as con:
+            row=con.execute("""
+                SELECT stage_code,status,url,source_repo,source_commit,source_checkout,
+                       app_container,gateway_container,data_isolated,source_bind_readonly,
+                       https_via_internal_proxy_verified
+                  FROM project_preview_source_links
+                 WHERE project_slug=?
+            """,(slug,)).fetchone()
+        if not row:return {}
+        stage,state,url,repo,commit,checkout,app,bridge,db_isolated,source_ro,https_ok=row
+        if (stage!='W1' or state!='online'
+            or url!='https://1026-w1-preview.cloudiff.duckdns.org/'
+            or repo!='cloudif-sgrep-v2/sgrep_v2'
+            or checkout!='/srv/cloudif/sgrep-v2/preview/source'
+            or app!='cloudif-sgrep-v2-preview-app'
+            or bridge!='cloudif-p1026-w1-preview-web'
+            or int(db_isolated)!=1 or int(source_ro)!=1 or int(https_ok)!=1
+            or len(commit)!=40 or any(c not in '0123456789abcdef' for c in commit)):
+            return {}
+        healthy,live_commit=_sgrep_w1_live_http()
+        return {'status':'active' if healthy else 'attention',
+                'previewId':'W1','buildJobId':'',
+                'commit':live_commit or commit,'createdAt':0,'expiresAt':0,'url':url,
+                'liveHealthVerified':healthy,
+                'linkMode':'forgejo_source_preview_w1',
+                'runtimeContainer':app,'bridgeContainer':bridge,
+                'sourceMode':'commit_pinned_optimized_build',
+                'managedByCloudiffPreviewFlow':False}
+    except (sqlite3.Error,OSError,TypeError,ValueError):
+        return {}
+
