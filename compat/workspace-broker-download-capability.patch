+def _download_ticket_artifact_id(ticket: str) -> str:
+    match=DOWNLOAD_TICKET_RE.fullmatch(str(ticket or '').strip())
+    if not match:
+        raise ArtifactError('invalid_download_ticket','A capability de download é inválida.','download_ticket')
+    return 'art_'+match.group(1)
+
+
+def _download_ticket_digest(ticket: str) -> str:
+    return hashlib.sha256(str(ticket).encode('utf-8')).hexdigest()
+
+
+def _validate_download_ticket_unlocked(artifact_root: str, ticket: str, *, allow_used: bool = False) -> tuple[dict[str, Any], str]:
+    artifact_id=_download_ticket_artifact_id(ticket)
+    data=_load(artifact_root,artifact_id)
+    record=data.get('download_ticket') if isinstance(data.get('download_ticket'),dict) else {}
+    stored=str(record.get('sha256') or '')
+    if not stored or not secrets.compare_digest(stored,_download_ticket_digest(ticket)):
+        raise ArtifactError('download_ticket_not_found','A capability de download não existe ou foi substituída.','download_ticket')
+    now=int(time.time())
+    if int(record.get('expires_at') or 0)<=now:
+        raise ArtifactError('download_ticket_expired','A capability de download expirou. Gere uma nova.','download_ticket')
+    if record.get('used_at') and not allow_used:
+        raise ArtifactError('download_ticket_used','A capability de download já foi utilizada. Gere uma nova.','download_ticket')
+    if data.get('status')!='sealed':
+        raise ArtifactError('artifact_not_sealed','O artifact precisa estar selado para download.','artifact_id')
+    return data,artifact_id
+
+
+def create_download_ticket(artifact_root: str, project_slug: str, artifact_id: str, requested_by: str = '', ttl_seconds: int = 900) -> dict[str, Any]:
+    try: ttl_seconds=int(ttl_seconds or 900)
+    except Exception as exc: raise ArtifactError('invalid_download_ticket_ttl','ttl_seconds deve ser inteiro.','ttl_seconds') from exc
+    if not (60<=ttl_seconds<=MAX_DOWNLOAD_TICKET_TTL):
+        raise ArtifactError('invalid_download_ticket_ttl','A capability de download pode durar entre 60 e 3600 segundos.','ttl_seconds')
+    with _artifact_lock(artifact_id):
+        data=_load(artifact_root,artifact_id)
+        if data.get('project_slug')!=project_slug:
+            raise ArtifactError('artifact_project_mismatch','O artefato pertence a outro projeto.','artifact_id')
+        resolved=_resolve_artifact_unlocked(artifact_root,project_slug,artifact_id)
+        now=int(time.time());expires=min(now+ttl_seconds,int(data.get('expires_at') or now+ttl_seconds))
+        if expires<=now:raise ArtifactError('artifact_expired','O artefato expirou.','artifact_id')
+        ticket='dlt_'+artifact_id[4:]+'_'+secrets.token_hex(24)
+        data['download_ticket']={'sha256':_download_ticket_digest(ticket),'created_at':now,'expires_at':expires,'requested_by':str(requested_by or '')[:160],'used_at':None}
+        data['updated_at']=now;_write_json_atomic(_meta_path(artifact_root,artifact_id),data)
+        result={k:v for k,v in resolved.items() if k!='payload_path'}
+        result.update({'download_ticket':ticket,'download_ticket_expires_at':expires,'download_ticket_ttl_seconds':expires-now,'download_ticket_one_time':True})
+        return result
+
+
+def consume_download_ticket(artifact_root: str, ticket: str) -> dict[str, Any]:
+    artifact_id=_download_ticket_artifact_id(ticket)
+    with _artifact_lock(artifact_id):
+        data,artifact_id=_validate_download_ticket_unlocked(artifact_root,ticket,allow_used=False)
+        project_slug=str(data.get('project_slug') or '')
+        resolved=_resolve_artifact_unlocked(artifact_root,project_slug,artifact_id)
+        record=dict(data.get('download_ticket') or {});record['used_at']=int(time.time());data['download_ticket']=record;data['updated_at']=record['used_at'];_write_json_atomic(_meta_path(artifact_root,artifact_id),data)
+        resolved.update({'download_ticket_expires_at':int(record.get('expires_at') or 0),'download_ticket_used_at':record['used_at']})
+        return resolved
+
