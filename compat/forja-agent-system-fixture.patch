+    if not re.fullmatch(r'^[a-z0-9][a-z0-9-]{0,62}$', value):
+        return None
+    return SYSTEM_FIXTURE_DIR / f"{value}.json"
+
+def load_system_fixture(slug):
+    p = system_fixture_path(slug)
+    if p is None or not p.exists():
+        return None
+    try:
+        data = json.loads(p.read_text(errors="ignore"))
+    except Exception:
+        return None
