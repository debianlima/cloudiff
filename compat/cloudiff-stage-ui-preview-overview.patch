+def _linked_integration_identity(slug:str)->dict[str,Any]:
+    if not PORTAL_DB.exists():return {}
+    try:
+        with sqlite3.connect(f'file:{PORTAL_DB}?mode=ro',uri=True,timeout=10) as con:
+            con.row_factory=sqlite3.Row
+            row=con.execute("select komodo_repo_id,komodo_stack_id,komodo_repo_name,komodo_stack_name from project_integrations where project=?",(slug,)).fetchone()
+            public=con.execute("select public_number from project_public_ids where project_slug=?",(slug,)).fetchone()
+        if not row or not public:return {}
+        expected='cloudif-'+slug
+        if str(row['komodo_repo_name'] or '')!=expected or str(row['komodo_stack_name'] or '')!=expected:return {}
+        repo=str(row['komodo_repo_id'] or '');stack=str(row['komodo_stack_id'] or '')
+        if len(repo)!=24 or len(stack)!=24:return {}
+        return {'publicNumber':int(public['public_number']),'repoId':repo,'stackId':stack}
+    except Exception:return {}
+
+
