+def _sgrep_w1_live_http():
+    # Independent authenticated TLS probe of the fixed publisher hostname.
+    # This reports the running commit from the W1 bridge, not the Git HEAD.
+    req=urllib.request.Request(
+        'https://1026-w1-preview.cloudiff.duckdns.org/health',
+        headers={'Cache-Control':'no-cache'},method='GET')
+    try:
+        with urllib.request.urlopen(req,timeout=6) as response:
+            if response.status!=200 or response.geturl()!='https://1026-w1-preview.cloudiff.duckdns.org/health':
+                return False,''
+            body=json.loads(response.read(800).decode('utf-8','replace'))
+            if not isinstance(body,dict) or body.get('ok') is not True or body.get('service')!='sgrep-web':
+                return False,''
+            sha=str(response.headers.get('X-CloudIFF-Source-Commit') or '').strip()
+            if not re.fullmatch(r'[a-f0-9]{40}',sha):sha=''
+            return True,sha
+    except (urllib.error.URLError,ValueError,OSError,TimeoutError):
+        return False,''
