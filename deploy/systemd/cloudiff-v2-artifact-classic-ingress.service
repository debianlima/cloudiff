[Unit]
Description=CloudIFF v2 ClassicArtifactIngress socket proxy
Requires=cloudiff-v2-artifact-executor-shadow.service
After=cloudiff-v2-artifact-executor-shadow.service

[Service]
Type=simple
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:18226
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid
