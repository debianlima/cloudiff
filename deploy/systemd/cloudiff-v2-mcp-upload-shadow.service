[Unit]
Description=CloudIFF v2 MCP upload compatibility planner shadow
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cloudiff-v2-agent
Group=cloudiff-v2-agent
EnvironmentFile=/etc/cloudiff-v2/mcp-upload-shadow.env
ExecStart=/opt/cloudiff-v2/mcp-upload-current/bin/cloudiff-agent --mcp-upload
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
