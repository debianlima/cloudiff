[Unit]
Description=CloudIFF v2 NpmPublisherProvider (shadow dry-run)
After=network-online.target cloudiff-v2-agent.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cloudiff-v2-agent
Group=cloudiff-v2-agent
EnvironmentFile=/etc/cloudiff-v2/publisher-shadow.env
ExecStart=/opt/cloudiff-v2/publisher-current/bin/cloudiff-agent --publisher
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/cloudiff-v2/publisher-shadow

[Install]
WantedBy=multi-user.target
