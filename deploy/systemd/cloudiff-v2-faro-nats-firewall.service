[Unit]
Description=CloudIFF v2 Faro NATS host firewall
After=network-online.target cloudif-input-firewall.service cloudiff-v2-nats-source-allowlist.socket
Wants=network-online.target
Requires=cloudiff-v2-nats-source-allowlist.socket

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cloudiff-v2-faro-nats-firewall apply
ExecStop=/usr/local/sbin/cloudiff-v2-faro-nats-firewall rollback
RemainAfterExit=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
