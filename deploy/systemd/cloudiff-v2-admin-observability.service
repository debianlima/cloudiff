[Unit]
Description=CloudIFF v2 AdminObservability loopback API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=cloudiff-v2-control
Group=cloudiff-v2-control
SupplementaryGroups=cloudiff-v2-nats
EnvironmentFile=/etc/cloudiff-v2/control.env
EnvironmentFile=/etc/cloudiff-v2/admin-observability.env
ExecStart=/opt/cloudiff-v2/admin-observability-current/cloudiff-agent --admin-observability
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
