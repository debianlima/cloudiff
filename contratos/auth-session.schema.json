{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudIFF Authentik Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "issuer",
    "authenticated",
    "roles"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "authenticated": {
      "const": true
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
