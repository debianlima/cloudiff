{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudIFF Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "occurred_at",
    "producer",
    "resource_id",
    "trace_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
