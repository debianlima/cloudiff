{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CloudIFF Toolchain Catalog v2",
  "type":"object",
  "additionalProperties":false,
  "required":["version","architectures","networkPolicies","baseImages","blockedRuntimes","systemPackages","tools","provisionPolicy","scannerPolicy"],
  "properties":{
    "version":{"const":2},
    "architectures":{"const":["amd64"]},
    "networkPolicies":{"type":"object","required":["none"],"properties":{"none":{"type":"object","required":["supported"],"properties":{"supported":{"const":true}}}}},
    "baseImages":{
      "type":"object","required":["static"],"additionalProperties":false,
      "properties":{"static":{"type":"object","required":["versions"],"properties":{"versions":{"type":"object","required":["default"],"properties":{"default":{"$ref":"#/$defs/approvedImage"}}}}}}
    },
    "blockedRuntimes":{"type":"object","required":["node"],"properties":{"node":{"type":"object","required":["24"],"properties":{"24":{"type":"object","required":["status","reason","scannerEvidence"],"properties":{"status":{"const":"blocked"},"reason":{"const":"security_scan_failed"},"scannerEvidence":{"type":"array","minItems":1}}}}}}},
    "systemPackages":{"const":{}},
    "tools":{"const":{}},
    "provisionPolicy":{"type":"object","required":["enabled","reason"],"properties":{"enabled":{"const":false},"reason":{"const":"no-approved-shell-build-runtime"}}},
    "scannerPolicy":{"type":"object","required":["block","offlineCache"],"properties":{"block":{"const":["HIGH","CRITICAL"]},"offlineCache":{"const":true}}}
  },
  "$defs":{
    "approvedImage":{
      "type":"object","additionalProperties":false,
      "required":["status","image","imageId","architectures","user","scannerCounts","scannerBlocked","scanDate"],
      "properties":{
        "status":{"const":"approved"},
        "image":{"pattern":"^.+@sha256:[a-f0-9]{64}$"},
        "imageId":{"pattern":"^sha256:[a-f0-9]{64}$"},
        "architectures":{"const":["amd64"]},
        "user":{"const":"65532"},
        "scannerCounts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
        "scannerBlocked":{"const":false},
        "scanDate":{"const":"2026-08-20"}
      }
    }
  }
}
