{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudIFF Durable Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "kind",
    "status",
    "partition_key",
    "idempotency_key",
    "attempt",
    "max_attempts",
    "created_at"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "leased",
        "waiting_retry",
        "succeeded",
        "failed",
        "dead_letter",
        "cancelled"
      ]
    },
    "partition_key": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retry_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
