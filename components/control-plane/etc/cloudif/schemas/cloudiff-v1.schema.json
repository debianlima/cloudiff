{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudiff.duckdns.org/schemas/cloudiff-v1.schema.json",
  "title": "CloudIFF Project Manifest",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "single-service",
            "multi-service"
          ]
        },
        "primaryService": {
          "$ref": "#/$defs/serviceName"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimes": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "maxProperties": 16
        },
        "systemPackages": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{0,79}$"
              },
              {
                "$ref": "#/$defs/systemPackage"
              }
            ]
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "rebuildOnChange": {
          "type": "boolean"
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "type": "string",
              "enum": [
                "static",
                "node",
                "php",
                "python",
                "java",
                "go",
                "rust",
                "ruby"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9._/:@-]+$"
            }
          }
        },
        "architecture": {
          "type": "string",
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          },
          "maxItems": 64
        },
        "provision": {
          "$ref": "#/$defs/provision"
        }
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "hooks": {
      "$ref": "#/$defs/hooks"
    },
    "services": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/serviceName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      },
      "minProperties": 1,
      "maxProperties": 32
    },
    "runtime": {
      "type": "string",
      "enum": [
        "static",
        "node",
        "php",
        "docker",
        "compose"
      ]
    },
    "path": {
      "$ref": "#/$defs/relativePath"
    },
    "publish": {
      "$ref": "#/$defs/relativePath"
    },
    "dockerfile": {
      "$ref": "#/$defs/relativePath"
    },
    "compose": {
      "$ref": "#/$defs/relativePath"
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/environmentName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/environmentOverlay"
      },
      "maxProperties": 4
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "services"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "runtime"
              ]
            },
            {
              "required": [
                "dockerfile"
              ]
            },
            {
              "required": [
                "compose"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "services"
          ]
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "runtime"
            ]
          },
          {
            "required": [
              "dockerfile"
            ]
          },
          {
            "required": [
              "compose"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "serviceName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "maxItems": 64
        }
      ]
    },
    "environment": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyProjectEnvironment"
        },
        {
          "$ref": "#/$defs/declarativeEnvironment"
        }
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "$ref": "#/$defs/serviceName"
        },
        "run": {
          "$ref": "#/$defs/command"
        },
        "script": {
          "$ref": "#/$defs/relativePath"
        },
        "shell": {
          "type": "string",
          "enum": [
            "bash",
            "sh",
            "php",
            "node"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "network": {
          "type": "string",
          "enum": [
            "none",
            "restricted",
            "project"
          ]
        },
        "continueOnError": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "run"
          ]
        },
        {
          "required": [
            "script"
          ]
        }
      ]
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preBuild": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          },
          "maxItems": 32
        },
        "postBuild": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          },
          "maxItems": 32
        },
        "preDeploy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          },
          "maxItems": 32
        },
        "postDeploy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          },
          "maxItems": 32
        }
      }
    },
    "healthcheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 300
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "retries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "startPeriodSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      },
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ]
    },
    "route": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 512
        },
        "stripPrefix": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "runtime"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "static",
            "node",
            "php",
            "docker",
            "compose"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "install": {
          "$ref": "#/$defs/command"
        },
        "build": {
          "$ref": "#/$defs/command"
        },
        "start": {
          "$ref": "#/$defs/command"
        },
        "publish": {
          "$ref": "#/$defs/relativePath"
        },
        "dockerfile": {
          "$ref": "#/$defs/relativePath"
        },
        "compose": {
          "$ref": "#/$defs/relativePath"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "healthcheck": {
          "$ref": "#/$defs/healthcheck"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceName"
          },
          "maxItems": 31,
          "uniqueItems": true
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          },
          "maxItems": 32
        },
        "environment": {
          "oneOf": [
            {
              "$ref": "#/$defs/legacyServiceEnvironment"
            },
            {
              "$ref": "#/$defs/declarativeEnvironment"
            }
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 8
            },
            "memoryMB": {
              "type": "integer",
              "minimum": 64,
              "maximum": 16384
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        }
      }
    },
    "environmentName": {
      "type": "string",
      "enum": [
        "development",
        "preview",
        "homologation",
        "production"
      ]
    },
    "environmentVariable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "scope": {
          "type": "string",
          "enum": [
            "project",
            "environment",
            "service"
          ]
        },
        "environments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/environmentName"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "exposeToClient": {
          "type": "boolean"
        },
        "immutable": {
          "type": "boolean"
        },
        "restartRequired": {
          "type": "boolean"
        },
        "buildTime": {
          "type": "boolean"
        },
        "runtime": {
          "type": "boolean"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "url",
                "email"
              ]
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "legacyProjectEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "maxProperties": 256
        },
        "required": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "services": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/serviceName"
                },
                "maxItems": 32,
                "uniqueItems": true
              },
              "secretRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{2,255}$"
              },
              "configRef": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{2,255}$"
              },
              "required": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "secretRef"
                ]
              },
              {
                "required": [
                  "configRef"
                ]
              }
            ]
          },
          "maxProperties": 256
        }
      }
    },
    "legacyServiceEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "variables": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "maxProperties": 256
        }
      }
    },
    "declarativeEnvironment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/environmentVariable"
      },
      "maxProperties": 256
    },
    "environmentOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "services": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/serviceName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "environment": {
                "$ref": "#/$defs/environment"
              }
            }
          },
          "maxProperties": 32
        }
      }
    },
    "systemPackage": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{0,79}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "enum": [
            "catalog",
            "distribution"
          ]
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "enum": [
            "catalog",
            "corepack",
            "distribution"
          ]
        },
        "installMethod": {
          "type": "string",
          "enum": [
            "catalog",
            "corepack",
            "distribution"
          ]
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "provision": {
      "type": "object",
      "required": [
        "script"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "$ref": "#/$defs/relativePath"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "network": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "restricted",
                "approved-domains"
              ]
            },
            {
              "type": "object",
              "required": [
                "mode"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "none",
                    "restricted",
                    "approved-domains"
                  ]
                },
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                }
              }
            }
          ]
        }
      }
    }
  }
}
