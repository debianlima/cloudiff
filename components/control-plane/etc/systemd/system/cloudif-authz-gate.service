[Unit]
Description=CloudIF AuthZ Gate for Authentik tenant authorization
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cloudif-authz-gate.env
ExecStart=/usr/bin/python3 /usr/local/sbin/cloudif-authz-gate.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
