[Unit]
Description=CloudIF reconcile project capability matrix
After=cloudif-project-onboarding-reconcile.service cloudif-mcp-gateway.service
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /srv/cloudif/app-pointers/project-capabilities-current/cloudif-project-capabilities.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/cloudif/onboarding /srv/cloudif/app-pointers /srv/cloudif/app-releases
ReadWritePaths=/var/lib/cloudif/health /etc/cloudif
