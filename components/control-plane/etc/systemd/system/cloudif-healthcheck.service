[Unit]
Description=CloudIF integrated health check
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cloudif-healthcheck.sh
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/cloudif-healthcheck.log /var/lib/cloudif/health /run /tmp
