[Unit]
Description=CloudIF Admin Portal v17 Clean
After=network-online.target docker.service cloudif-multiservice-preview-broker.service
Wants=network-online.target cloudif-multiservice-preview-broker.service

[Service]
Type=simple
EnvironmentFile=/etc/cloudif/portal.env
EnvironmentFile=-/etc/cloudif/multiservice-preview.env
ExecStart=/usr/bin/python3 /srv/cloudif/app-pointers/portal-current/cloudif-admin-portal.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
