[Unit]
Description=Remove stale CloudIF managed workspace containers
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
Environment=DOCKER_CONFIG=/run/cloudif-docker-config-empty
ExecStart=/usr/bin/python3 /usr/local/sbin/cloudif-workspace-cleanup.py
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadOnlyPaths=/var/run/docker.sock
ReadWritePaths=/run /var/lib/cloudif/workspaces /var/lib/cloudif/health
