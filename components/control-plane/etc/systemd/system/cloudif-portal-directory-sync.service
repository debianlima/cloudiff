[Unit]
Description=CloudIFF Portal directory cache sync from Authentik
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/cloudif/portal-directory.env
ExecStart=/usr/bin/python3 /srv/cloudif/lib/cloudif_directory_cache.py sync
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
