[Unit]
Description=CloudIF Certificate Alert Dispatcher
After=cloudif-machine-controller.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
EnvironmentFile=/etc/cloudif/machine-controller-db.env
ExecStart=/usr/bin/python3 /usr/local/sbin/cloudif-certificate-alert-dispatcher.py
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/cloudif /srv/cloudif/lib
