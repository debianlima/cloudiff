[Unit]
Description=CloudIF preview lifecycle broker
After=cloudif-build-broker.service
[Service]
Type=simple
User=cloudif-control
Group=cloudif-control
EnvironmentFile=/etc/cloudif/preview-broker.env
ExecStart=/usr/bin/python3 /srv/cloudif/app-pointers/preview-broker-current/cloudif-preview-broker.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudif/preview-broker
ReadOnlyPaths=/var/lib/cloudif/build-broker /etc/cloudif/preview-broker.env /srv/cloudif/app-releases/preview-broker /srv/cloudif/app-pointers
CapabilityBoundingSet=
UMask=0077
[Install]
WantedBy=multi-user.target
