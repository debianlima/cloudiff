[Unit]
Description=CloudIFF Hospedagem dynamic reverse relays for active project leases
After=cloudif-remote-connector-master.service cloudif-admin-portal.service
Requires=cloudif-remote-connector-master.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/cloudif-remote-connector-sync.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/cloudif/remote-access.env

[Install]
WantedBy=multi-user.target
