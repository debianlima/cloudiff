[Unit]
Description=CloudIF Runtime Policy and Planning API
After=network.target
[Service]
Type=simple
User=cloudif-control
Group=cloudif-control
Environment=CLOUDIF_RUNTIME_POLICY=/etc/cloudif/runtime-policy.json
Environment=CLOUDIF_RUNTIME_HOST=127.0.0.1
Environment=CLOUDIF_RUNTIME_PORT=18212
ExecStart=/usr/bin/python3 /srv/cloudif/app-pointers/runtime-policy-current/cloudif-runtime-policy.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/cloudif/runtime-policy.json /srv/cloudif/app-releases/runtime-policy /srv/cloudif/app-pointers
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any
CapabilityBoundingSet=
UMask=0077
[Install]
WantedBy=multi-user.target
