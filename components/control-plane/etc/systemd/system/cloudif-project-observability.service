[Unit]
Description=CloudIFF project observability and drift metrics
After=cloudif-project-runtime-reconciler.service cloudif-build-broker.service cloudif-project-config-controller.service
Requires=cloudif-project-runtime-reconciler.service

[Service]
Type=simple
User=cloudif-control
Group=cloudif-control
EnvironmentFile=/etc/cloudif/project-observability.env
EnvironmentFile=/etc/cloudif/runtime-reconciler.env
EnvironmentFile=/etc/cloudif/project-config-controller.env
EnvironmentFile=/etc/cloudif/build-broker.env
ExecStart=/usr/bin/python3 /srv/cloudif/app-pointers/project-observability-current/cloudif-project-observability.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudif/runtime-reconciler /var/lib/cloudif/project-config /var/lib/cloudif/build-broker
ReadOnlyPaths=/etc/cloudif /srv/cloudif/app-releases/project-observability /srv/cloudif/app-pointers
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=127.0.0.0/8
IPAddressDeny=any
UMask=0077

[Install]
WantedBy=multi-user.target
