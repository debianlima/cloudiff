[Unit]
Description=CloudIFF FRP-Panel master and FRP edge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cloudif/frp-panel.env
ExecStart=/usr/local/bin/cloudif-frp-panel master
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudiff/frp-panel /tmp
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
