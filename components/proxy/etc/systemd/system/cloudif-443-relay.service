[Unit]
Description=CloudIFF 443 protocol relay (HTTPS + SSH gateway)
After=network-online.target cloudif-remote-gateway.service docker.service
Wants=network-online.target
Requires=cloudif-remote-gateway.service

[Service]
Type=simple
User=sslh
Group=sslh
ExecStart=/usr/sbin/sslh -f -n -p 0.0.0.0:443 --ssh 127.0.0.1:10022 --tls 127.0.0.1:10443 --on-timeout tls --timeout 5
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
