[Unit]
Description=CloudIF NPM publication agent
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /srv/cloudif/app-pointers/publisher-agent-current/cloudif-npm-publisher-agent.py
Restart=on-failure
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
[Install]
WantedBy=multi-user.target
