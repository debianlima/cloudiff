  "networkPolicies": {
    "none": {
      "supported": true,
      "description": "Sem acesso de rede durante o build."
    },
    "restricted": {
      "supported": false,
      "requires": "internal-dependency-proxy"
    },
    "approved-domains": {
      "supported": false,
      "requires": "egress-domain-enforcement"
    }
