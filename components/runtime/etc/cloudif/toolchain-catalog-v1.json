  "provisionPolicy": {
    "maxBytes": 262144,
    "maxTimeoutSeconds": 1800,
    "requiredShebangs": [
      "#!/usr/bin/env bash",
      "#!/bin/bash"
    ],
    "forbiddenPatterns": [
      "(?:^|\\s)sudo(?:\\s|$)",
      "(?:^|\\s)(?:mount|umount|nsenter|chroot|pivot_root)(?:\\s|$)",
      "(?:^|\\s)systemctl(?:\\s|$)",
      "/var/run/docker\\.sock",
      "--privileged",
      "(?:^|\\s)docker(?:\\s|$)",
      "(?:^|\\s)podman(?:\\s|$)",
      "(?:curl|wget)[^\\n|]*\\|\\s*(?:sh|bash)",
      "(?:^|\\s)iptables(?:\\s|$)",
      "(?:^|\\s)modprobe(?:\\s|$)",
      "(?:^|\\s)dd\\s+.*(?:/dev/|of=/)",
      "(?:^|\\s)mkfs(?:\\.|\\s)",
      "(?:^|\\s)reboot(?:\\s|$)",
      "(?:^|\\s)shutdown(?:\\s|$)"
    ]
  }
